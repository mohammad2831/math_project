# Environment configuration template for Sigma-Backend
# Copy this file to .env and update placeholders with your actual values.

# Django
DJANGO_SECRET_KEY=replace-with-a-secure-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DJANGO_DB_PATH=db.sqlite3

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# SMS Services
KAVENEGAR_API_KEY=replace-with-your-kavenegar-api-key
SMSIR_API_KEY=replace-with-your-smsir-api-key
SMSIR_LINE_NUMBER=replace-with-your-smsir-line-number
